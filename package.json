{
  "name": "erpnext-qa-portfolio",
  "version": "1.0.0",
  "description": "Functional UI and API test automation suite for ERPNext, built with Playwright + TypeScript.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.46.2",
    "allure-playwright": "^3.15.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.7.2"
  }
}
